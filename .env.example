# Server Configuration
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# Database
MONGODB_URI=mongodb://localhost:27017/jersey-world

# Security / JWT
JWT_ACCESS_SECRET=jersey_world_super_secret_access_jwt_key_2026_x9281!
JWT_REFRESH_SECRET=jersey_world_super_secret_refresh_jwt_key_2026_w1928#
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# AI Try-On Provider
# Options: 'neural-canvas' (Built-in zero-key high-fidelity engine) | 'gemini' | 'replicate'
AI_PROVIDER=neural-canvas
AI_API_KEY=
GEMINI_API_KEY=
REPLICATE_API_TOKEN=

# Storage Provider
# Options: 'local' | 'cloudinary' | 's3'
STORAGE_PROVIDER=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Payment Gateway (Razorpay)
# Options: 'razorpay' | 'simulator'
PAYMENT_PROVIDER=simulator
RAZORPAY_KEY_ID=rzp_test_sampleKey12345
RAZORPAY_KEY_SECRET=rzp_secret_sampleSecret98765

# Redis (Optional caching & pubsub queue)
REDIS_URL=redis://localhost:6379

# Admin AI Limits
MAX_FREE_DAILY_TRYONS=5
MAX_VIP_DAILY_TRYONS=25
TRYON_JOB_TIMEOUT_SECONDS=60
